# Merge with existing configuration; this is NOT a secret file.
CASEWORK_ENABLED=0
# Create locally with scripts/casework_create_credentials.py; use an absolute path.
CASEWORK_AUTH_FILE=/absolute/path/to/.casework-private/registry.json
# Set only after committing the final reviewed code; same full SHA across restart.
# BUILD_COMMIT=<full-40-character-git-sha>
# Optional, actual newly deployed v2 contract and explicit audit wallet. No keys.
# CASEWORK_BASE_ANCHOR_ADDRESS=0x...
# CASEWORK_ANCHOR_ATTESTER=0x...
# Existing BASE_CHAIN_ID and BASE_RPC_URL must match the optional contract network.
# Existing AGENT_MODEL_* configuration selects optional bounded remote investigation.
