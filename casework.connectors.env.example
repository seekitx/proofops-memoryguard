# Merge into your existing environment; this file contains no secrets.
# Defaults remain opt-in. Never use example subject/target for real authority.
CASEWORK_ENABLED=0
CASEWORK_CONNECTORS_FILE=/absolute/path/to/.casework-private/connectors.json
# Optional explicit synthetic export for the PUBLIC evidence page, never a DB path:
# CASEWORK_SOURCE_EXPERIMENT_PATH=/absolute/path/to/source-experiment.json
# Only for the LOCAL MCP client process (do not commit tokens):
# MEMORYGUARD_API_ORIGIN=https://your-owned-memoryguard-host
# MEMORYGUARD_VIEWER_TOKEN=<locally-provided-viewer-token>
# Optional server-side secrets are environment values, NOT JSON source values:
# MEMORYGUARD_GITHUB_TOKEN=<read-only-token>
# MEMORYGUARD_INCIDENT_SECRET=<independent-random-32+-character-secret>
