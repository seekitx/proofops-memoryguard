APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
GITHUB_REPO_URL=https://github.com/seekitx/proofops-memoryguard
BUILD_COMMIT=uncommitted-local-prototype
DATA_DIR=.data
SIBYL_MEMORY_PATH=.data/sibyl-memory.db
SIBYL_TENANT_ID=proofops-memoryguard-demo
MEMORYGUARD_POLICY_PATH=config/memoryguard-policy.json
DECISION_TTL_SECONDS=600

# Development can use the visibly labelled deterministic planner. Production
# refuses to start unless a real HTTPS model endpoint is configured.
AGENT_MODEL_MODE=deterministic
AGENT_MODEL_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT_SECONDS=20

# Base is optional for local development. No Base credit is claimed until a real
# wallet-confirmed action and independent receipt verification are captured.
BASE_CHAIN_ID=84532
BASE_NETWORK=base-sepolia
BASE_RPC_URL=https://sepolia.base.org
BASE_ANCHOR_ADDRESS=
BASE_RPC_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=http://localhost:8000
